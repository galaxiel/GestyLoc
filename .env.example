# Variables d'environnement pour le packaging / publication GitHub.
# Copier ce fichier en .env et renseigner les valeurs réelles.

# Token GitHub avec droit "repo" (créer sur https://github.com/settings/tokens).
# Sert UNIQUEMENT à PUBLIER les releases (commande build:win --publish always).
# L'updater côté client n'en a PAS besoin.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : utilisateur GitHub lié au token (pour certaines API electron-builder).
# GH_USER=galaxiel
